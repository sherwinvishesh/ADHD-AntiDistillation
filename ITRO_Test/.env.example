# Actual API keys / QWEN_MODEL_PATH live in ../ITRO/.env — no need to
# duplicate them here (ITRO's own config.py loads them independently).
#
# This file only controls which provider ITRO_Test defaults to when you
# run main.py. If unset, you'll be prompted interactively instead.
# Accepts: anthropic, claude, gemini, qwen, local, qwen-local, or 1/2/3.
ITRO_DEFAULT_PROVIDER=
