# ── Cloud provider keys ────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Model names (optional overrides) ────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-1.5-pro

# ── Default provider ────────────────────────────────────────────
# If set, main.py skips the interactive provider menu and goes
# straight to question-answering. Accepts: anthropic, claude,
# gemini, or the numeric key (1/2).
# Leave blank to always be prompted.
SPECTRE_DEFAULT_PROVIDER=
