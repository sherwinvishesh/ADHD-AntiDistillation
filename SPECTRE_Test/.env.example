# Actual API keys live in ../SPECTRE/.env — no need to duplicate them
# here (SPECTRE's own config.py loads them independently).
#
# This file only controls which provider SPECTRE_Test defaults to when
# you run main.py. If unset, you'll be prompted interactively instead.
# Accepts: anthropic, claude, gemini, or 1/2.
SPECTRE_DEFAULT_PROVIDER=
