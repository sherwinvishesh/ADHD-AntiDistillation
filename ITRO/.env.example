# ── Cloud provider keys ────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Local Qwen model (only needed for provider 3 / "qwen") ─────
QWEN_MODEL_PATH=
USE_4BIT=false

# ── Default provider ────────────────────────────────────────────
# If set, main.py skips the interactive provider menu and goes
# straight to question-answering. Accepts: anthropic, claude,
# gemini, qwen, local, qwen-local, or the numeric key (1/2/3).
# Leave blank to always be prompted.
ITRO_DEFAULT_PROVIDER=
